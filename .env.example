# ─────────────────────────────────────────────────────────────────────────────
# MambyTech environment configuration — copy to .env.local and fill in.
# Never commit real values. Only NEXT_PUBLIC_* variables reach the browser.
# Changing these requires a rebuild/redeploy.
# ─────────────────────────────────────────────────────────────────────────────

# Public base URL used for canonical links, the sitemap and social previews.
# mambytech.com is preferred but not yet confirmed; set this once the domain is owned.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Content preview: "true" shows draft projects and unconfirmed content with
# labels, and blocks search indexing. Never enable on the public site.
CONTENT_PREVIEW=false

# ── Contact form ─────────────────────────────────────────────────────────────
# Provider: "resend" (real delivery) or "mock" (development only; never sends).
# Leave unset to show the honest "contact form unavailable" state.
CONTACT_PROVIDER=

# Resend (https://resend.com): an API key with "sending access" only.
RESEND_API_KEY=
# Inbox that receives messages.
CONTACT_TO_EMAIL=
# Sender on a domain verified in Resend, e.g. MambyTech <contact@mambytech.com>
CONTACT_FROM_EMAIL=

# Development only, with CONTACT_PROVIDER=mock: success or failure.
CONTACT_MOCK_RESULT=success

# ── Rate limiting (recommended for serverless hosting) ───────────────────────
# Without these, an in-memory limiter is used (fine on a single server,
# best-effort on serverless). A free Upstash Redis database shares limits.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Privacy page ─────────────────────────────────────────────────────────────
# Name of the hosting provider, shown on /privacy (e.g. Cloudflare).
HOSTING_PROVIDER_NAME=
