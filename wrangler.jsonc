{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mambytech",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-01",
  // nodejs_compat: node:crypto (rate-limit hashing) and process.env for settings.
  // global_fetch_strictly_public: outbound fetch only reaches public hosts.
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // next/image optimisation through Cloudflare Images.
  "images": {
    "binding": "IMAGES"
  },
  "observability": {
    "enabled": true
  }
}
